{
  "name": "xiaoke-compress",
  "version": "1.1.0",
  "description": "小柯機器人MP4影片壓縮工具：影片、圖片、音訊一鍵壓縮成小檔案，可指定檔案大小、解析度、編碼，並有語音動態教學",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "app": "vite build && electron .",
    "electron": "electron .",
    "dist:win": "tsc && vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "tsc && vite build && electron-builder --mac dmg --publish never",
    "icon": "python scripts/make_icon.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "private": true,
  "productName": "小柯機器人MP4影片壓縮工具",
  "main": "electron/main.cjs",
  "author": {
    "name": "吳玉柱",
    "url": "https://github.com/achir1015"
  },
  "homepage": "https://github.com/achir1015/xiaoke-compress",
  "build": {
    "appId": "com.achir.xiaokecompress",
    "productName": "小柯機器人MP4影片壓縮工具",
    "artifactName": "XiaokeCompress-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 吳玉柱",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      { "from": "node_modules/ffmpeg-static", "to": "bin", "filter": ["ffmpeg", "ffmpeg.exe", "LICENSE", "*.LICENSE", "*.README"] },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "XiaokeCompress"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小柯機器人MP4影片壓縮工具",
      "uninstallDisplayName": "小柯機器人MP4影片壓縮工具",
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ]
    },
    "portable": {
      "artifactName": "XiaokeCompress-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null
    },
    "dmg": {
      "title": "小柯機器人MP4影片壓縮工具 ${version}"
    },
    "npmRebuild": false,
    "afterSign": "build/adhoc-sign.cjs"
  }
}
